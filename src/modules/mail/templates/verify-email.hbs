{{#> layout
  title="Vérification email"
  preheader="Votre code de vérification TunRent"
  badge="Sécurité"
  badgeBg="#eff6ff"
  badgeColor="#1e3a5f"
  heading=(concat "Bonjour " firstName ",")
  subheading="Utilisez le code ci-dessous pour activer votre compte TunRent."
}}
  <p style="margin:0 0 8px;font-size:15px;line-height:1.6;color:#475569;">
    Saisissez ce code sur la page de vérification :
  </p>

  {{> code-box code=verificationCode}}

  <p style="margin:0;font-size:14px;line-height:1.6;color:#64748b;text-align:center;">
    Ce code expire dans <strong style="color:#1a1a2e;">{{expiresMinutes}} minutes</strong>.
  </p>

  {{> note
    bg="#f8fafc"
    border="#94a3b8"
    text="Si vous n'avez pas créé de compte TunRent, vous pouvez ignorer cet email en toute sécurité."
  }}
{{/layout}}
