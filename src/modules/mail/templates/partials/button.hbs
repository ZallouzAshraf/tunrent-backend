<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:{{#if margin}}{{margin}}{{else}}28px auto{{/if}};">
  <tr>
    <td align="center" style="border-radius:10px;background-color:#1e3a5f;mso-padding-alt:14px 32px;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{href}}" style="height:48px;v-text-anchor:middle;width:220px;" arcsize="20%" strokecolor="#1e3a5f" fillcolor="#1e3a5f">
        <w:anchorlock/>
        <center style="color:#ffffff;font-family:sans-serif;font-size:15px;font-weight:bold;">{{label}}</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{href}}" target="_blank" style="display:inline-block;padding:14px 36px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:10px;background-color:#1e3a5f;">
        {{label}}
      </a>
      <!--<![endif]-->
    </td>
  </tr>
</table>
