{{#> layout
  title="Nouvelle demande de réservation"
  preheader=(concat "Nouvelle demande " bookingReference)
  badge="Nouvelle demande"
  badgeBg="#fffbeb"
  badgeColor="#b45309"
  heading="Nouvelle réservation à traiter"
  subheading=(concat "Bonjour " agencyName ", un client souhaite louer un véhicule.")
}}
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:8px 0 24px;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
    {{> detail-row label="Référence" value=bookingReference}}
    {{> detail-row label="Client" value=(concat clientName " · " clientEmail)}}
    {{> detail-row label="Téléphone" value=clientPhone}}
    {{> detail-row label="Véhicule" value=carName}}
    {{> detail-row label="Dates" value=(concat startDate " → " endDate)}}
    {{> detail-row label="Total estimé" value=(concat totalPrice " TND")}}
  </table>

  {{> button href=dashboardUrl label="Voir la demande"}}

  {{> note
    bg="#fffbeb"
    border="#d97706"
    text="Répondez rapidement pour maximiser vos chances de conversion. Les demandes en attente trop longtemps peuvent être annulées par le client."
  }}
{{/layout}}
