{{#> layout
  title="Invitation équipe"
  preheader=(concat "Rejoignez l'équipe " agencyName)
  badge="Invitation"
  badgeBg="#eff6ff"
  badgeColor="#1e3a5f"
  heading=(concat "Rejoignez " agencyName)
  subheading=(concat invitedByName " vous invite à rejoindre l'équipe en tant que " role ".")
}}
  <p style="margin:0 0 8px;font-size:15px;line-height:1.6;color:#475569;">
    Acceptez l'invitation pour accéder au tableau de bord agence : gestion des voitures, réservations et équipe.
  </p>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:16px 0 24px;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
    {{> detail-row label="Agence" value=agencyName}}
    {{> detail-row label="Rôle" value=role}}
    {{> detail-row label="Invité par" value=invitedByName}}
    {{> detail-row label="Email" value=inviteeEmail}}
  </table>

  {{> button href=invitationUrl label="Accepter l'invitation"}}

  {{> note
    bg="#f8fafc"
    border="#94a3b8"
    text="Ce lien est personnel et expire après un délai limité. Si vous n'attendiez pas cette invitation, ignorez cet email."
  }}
{{/layout}}
