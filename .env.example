# Mail (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your-user
MAIL_PASS=your-pass
MAIL_FROM="Location Auto Tunisie <noreply@locationauto.tn>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Flouci (paiement tunisien)
FLOUCI_APP_TOKEN=
FLOUCI_SECRET_TOKEN=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=20
THROTTLE_LOGIN_TTL=60000
