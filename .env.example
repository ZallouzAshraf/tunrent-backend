# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
# Optional: multiple origins (comma-separated), e.g. prod + www + Vercel preview
# CORS_ORIGINS=https://tunrent.tn,https://www.tunrent.tn

# Database (Supabase direct: port 5432 | pooler: DB_USE_POOLER=true port 6543)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_NAME=car_rental_tn
DB_SSL=true
# DB_USE_POOLER=true
# MIGRATIONS_RUN=false

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# ─── Mail (gratuit, dev + prod) ────────────────────────────────────────────
# Provider : brevo (défaut) | mailtrap | gmail | smtp
# Même config en dev et prod — seul FRONTEND_URL change en production.
#
# ▶ Brevo (recommandé) — 300 emails/jour gratuits, vrais emails
#   1. https://www.brevo.com
#   2. Expéditeurs → vérifier votre email (ex: votre@gmail.com)
#   3. SMTP & API → Clés SMTP → Générer
#   4. Remplir ci-dessous puis : npm run mail:test
MAIL_PROVIDER=brevo
# Login SMTP (onglet SMTP) — souvent xxx@smtp-brevo.com, PAS l'email expéditeur
MAIL_SMTP_LOGIN=
MAIL_USER=
MAIL_PASS=
# Optionnel — par défaut = TunRent <MAIL_USER>
# MAIL_FROM="TunRent <votre@gmail.com>"
MAIL_ADMIN_EMAIL=
MAIL_TEST_TO=
MAIL_ENABLED=true
#
# ▶ Mailtrap (sandbox, emails fictifs — tests UI seulement)
# MAIL_PROVIDER=mailtrap
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
#
# ▶ Gmail (mot de passe d'application Google)
# MAIL_PROVIDER=gmail
# MAIL_USER=votre@gmail.com
# MAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Flouci (paiement tunisien)
FLOUCI_APP_TOKEN=
FLOUCI_SECRET_TOKEN=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=20
THROTTLE_LOGIN_TTL=60000

# Seed voitures (npm run seed:cars)
SEED_AGENCY_SLUG=ashraf-agence
# SEED_FORCE=true
