# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=tunrent
DB_PASSWORD=tunrent
DB_NAME=car_rental_tn

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# Mail (SMTP)
# Mail — Mailtrap (dev, recommandé) | Brevo/Gmail (prod)
# Mailtrap : https://mailtrap.io → Sandboxes → Integration → SMTP
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="TunRent <noreply@tunrent.tn>"
MAIL_ADMIN_EMAIL=
MAIL_TEST_TO=
MAIL_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Flouci (paiement tunisien)
FLOUCI_APP_TOKEN=
FLOUCI_SECRET_TOKEN=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=20
THROTTLE_LOGIN_TTL=60000

# Seed voitures (npm run seed:cars)
SEED_AGENCY_SLUG=ashraf-agence
# SEED_FORCE=true
